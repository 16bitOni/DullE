# ─────────────────────────────────────────────────────────────
# DullE Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All settings use the DULLE_ prefix.
# ── API (required) ──────────────────────────────────────────
# One key and one base URL — access all models through the same endpoint.
DULLE_API_KEY=
DULLE_BASE_URL=

# ── Model names (change these to whatever your endpoint serves) ──
DULLE_PLANNER_MODEL=global.anthropic.claude-sonnet-4-6         # Text model for task planning
DULLE_EXECUTOR_MODEL=global.anthropic.claude-sonnet-4-6           # Vision model for screen interaction
DULLE_VERIFIER_MODEL=global.anthropic.claude-sonnet-4-6     # Reliable model for verification
# ── Smart model escalation (optional) ──────────────────────
# Stronger fallback model — used automatically when the executor
# gets stuck in a loop or fails a step. Leave empty to disable.
#
# Recommended combos (cheap executor → heavy fallback):
#   qwen3-vl        → claude-sonnet-4       (best balance)
#   gemini-2.5-flash → claude-sonnet-4      (cheapest that works)
#   gpt-4o-mini     → gpt-4o               (OpenAI-only setup)
#   gemini-2.0-flash → gemini-2.5-pro       (Google-only setup)
DULLE_EXECUTOR_MODEL_HEAVY=

# ── Execution mode ──────────────────────────────────────────
# hybrid = CLI commands first, screenshots for GUI-only tasks (recommended)
# vision = screenshot-only (classic computer use)
# cli    = command-line only (no screenshots)
DULLE_EXECUTION_MODE=hybrid

# ── Agent behavior ──────────────────────────────────────────
DULLE_MAX_ITERATIONS=40
DULLE_MAX_STEPS=20
DULLE_MAX_TOKENS=4096
DULLE_STEP_TIMEOUT_S=120.0
DULLE_LLM_TIMEOUT_S=60.0

# ── Shell ───────────────────────────────────────────────────
# cmd or powershell
DULLE_SHELL=cmd
DULLE_SHELL_TIMEOUT_S=30.0
DULLE_REQUIRE_SHELL_CONFIRMATION=true
DULLE_ENABLE_SHELL_BLOCKLIST=true
DULLE_MAX_OUTPUT_CHARS=5000

# ── Screenshot ──────────────────────────────────────────────
DULLE_MAX_LONG_EDGE=1568
DULLE_MAX_TOTAL_PIXELS=1150000
# png or jpeg (jpeg is smaller but lower quality)
DULLE_SCREENSHOT_FORMAT=png
DULLE_JPEG_QUALITY=80

# ── Safety ──────────────────────────────────────────────────
DULLE_REQUIRE_CONFIRMATION=true
DULLE_ENABLE_BLOCKLIST=true
DULLE_ENABLE_AUDIT_TRAIL=true
DULLE_AUDIT_TRAIL_DIR=audit_trail
DULLE_MAX_COST_PER_TASK_USD=3.0

# ── Knowledge base ──────────────────────────────────────────
# Path to your personal knowledge file (see knowledge.yaml)
DULLE_KNOWLEDGE_FILE=knowledge.yaml

# ── Logging ─────────────────────────────────────────────────
DULLE_LOG_LEVEL=INFO
DULLE_LOG_FILE=dulle.log
DULLE_VERBOSE=false

